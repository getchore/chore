# The website. Its own project — pnpm, vite and a lockfile of its own — so
# its tasks live beside it and the root chorefile includes them as `web`.
#
# Every task here runs from this directory, whichever directory `chore` was
# invoked from, because a task's `cd` is undone when it returns.

# Install the pinned dependencies.
task deps {
    cd $ROOT/website
    pnpm install --frozen-lockfile
}

# Build the site the way GitHub Pages does, base path included.
task build {
    deps
    cd $ROOT/website
    # Pages serves a project site from /<repo>/, so the asset base has to
    # match or every URL in the built page is wrong by one path segment.
    env VITE_BASE /chore/
    pnpm build
}

# Serve the site locally with hot reload.
task dev {
    deps
    cd $ROOT/website
    pnpm dev
}

# Remove the build output.
task clean {
    remove $ROOT/website/dist
}
